# Copy to ops/.env on the server and fill in real secrets. ops/.env is gitignored.
#
# Two passwords are involved:
#   - POSTGRES_PASSWORD is the db_admin (superuser) password. It MUST match the
#     password in DB_ADMIN_URL below.
#   - The 'app' role password is fixed to 'app_pw' by migration 0001, so the app
#     password in DATABASE_URL must stay 'app_pw' unless you change that migration.

# --- Postgres superuser (used by Alembic migrations) ---
POSTGRES_PASSWORD=change-me-strong-db-admin-pw

# --- Backend ---
DATABASE_URL=postgresql+psycopg://app:app_pw@db:5432/cod2
DB_ADMIN_URL=postgresql+psycopg://db_admin:change-me-strong-db-admin-pw@db:5432/cod2
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-please-use-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOG_LEVEL=INFO
LOGIN_RATE_LIMIT=5/5minutes
# Served behind HTTPS in prod, so the refresh cookie must be Secure.
COOKIE_SECURE=true
# Same-origin (Caddy) means CORS isn't strictly needed, but keep it consistent:
ALLOWED_ORIGINS=https://CHANGE_ME.nip.io

# First-boot admin (created once, then ignored). Rotate the password after first login.
BOOTSTRAP_ADMIN_PERSONAL_NUMBER=1000001
BOOTSTRAP_ADMIN_FULL_NAME=Initial Admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstLogin!

# --- Caddy ---
# Public address Caddy serves and obtains TLS for. Use your VM's external IP with nip.io,
# e.g. SITE_ADDRESS=34.12.34.56.nip.io  (no scheme). For local testing use: localhost
SITE_ADDRESS=CHANGE_ME.nip.io
