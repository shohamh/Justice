# Non-secret dev defaults, committed to git so a fresh clone works out of the
# box with `.\dev.ps1`. Anything set in `.env` (gitignored) overrides these —
# use it for the Telegram bot token and any machine-specific values (e.g. a
# personal Tailscale hostname).

# Backend
DATABASE_URL=postgresql+psycopg://app:app_pw@db:5432/justice
DB_ADMIN_URL=postgresql+psycopg://db_admin:db_admin_pw@db:5432/justice
JWT_SECRET=change-me-in-prod-this-is-only-a-dev-default-with-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ENVIRONMENT=development
LOGIN_RATE_LIMIT=10/5minutes
COOKIE_SECURE=false
REDIS_URL=redis://redis:6379/0
# Empty by default so the Loki push handler is opt-in for anyone running the
# backend directly (bare `uvicorn`, or a native/non-observability dev flow).
# The dev paths that include the observability stack (Task 7) set this
# explicitly instead of relying on this default: docker-compose.yml's backend
# service environment block (http://loki:3100), and dev.ps1 for the
# natively-run backend (http://localhost:3100).
LOKI_URL=
ERROR_LOG_RATE_LIMIT_MAX_PER_WINDOW=10
ERROR_LOG_RATE_LIMIT_WINDOW_SECONDS=60

# First-boot admin (bootstrap.py reads these once; rotate after first login)
BOOTSTRAP_ADMIN_PERSONAL_NUMBER=1000001
BOOTSTRAP_ADMIN_FULL_NAME=Initial Admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstLogin!

TELEGRAM_BOT_USERNAME=call_of_duty2bot

FRONTEND_URL=http://localhost:5173

# HR integration
HR_API_PAGE_SIZE=200

# Frontend
VITE_API_BASE=http://localhost:8000/api
VITE_ERROR_RATE_LIMIT_MAX_PER_WINDOW=10
VITE_ERROR_RATE_LIMIT_WINDOW_MS=60000
