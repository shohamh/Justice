# Template for .env — your local secrets and personal-machine overrides.
# Copy to .env (gitignored). Everything else already has a working default
# in .env.defaults (committed), so most devs only need the bot token below.

# Telegram bot token from @BotFather — leave blank to disable the bot.
TELEGRAM_BOT_TOKEN=

# HR (משא"ן) integration — leave both blank to disable
HR_API_BASE_URL=
HR_API_KEY=
# Path to a CA bundle (.pem) for verifying an internally-signed HR server,
# e.g. mounted via the backend/certs/ volume in docker-compose.yml.
# Leave blank to use the system trust store.
# HR_API_CA_BUNDLE_PATH=/app/certs/internal-ca.pem

# Uncomment to override a default from .env.defaults for this machine only:
# ALLOWED_ORIGINS=http://localhost:5173,https://your-tailnet-host.ts.net
# FRONTEND_URL=https://your-tailnet-host.ts.net
# COOKIE_SECURE=true
