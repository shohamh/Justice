{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::justice-files",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "soldier_exemption/*",
            "exemption_request/*",
            "gimelim/*",
            "bug_report_screenshot/*",
            "bug_report_comment/*",
            "import_workbook/*",
            "bug_report_json_mirror/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::justice-files/soldier_exemption/*",
        "arn:aws:s3:::justice-files/exemption_request/*",
        "arn:aws:s3:::justice-files/gimelim/*",
        "arn:aws:s3:::justice-files/bug_report_screenshot/*",
        "arn:aws:s3:::justice-files/bug_report_comment/*",
        "arn:aws:s3:::justice-files/import_workbook/*",
        "arn:aws:s3:::justice-files/bug_report_json_mirror/*"
      ]
    }
  ]
}
