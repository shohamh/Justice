# Copy to deploy/.env.production and fill in every value.
# NEVER commit .env.production to git.

# ── Database ─────────────────────────────────────────────────────
# Use a strong random password. Rotate annually.
DATABASE_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@db:5432/justice
DB_ADMIN_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@db:5432/justice
DB_USER=justice
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# ── Performance ──────────────────────────────────────────────────
# Number of uvicorn worker processes. Each worker is a separate OS
# process with its own DB connection pool (see backend/app/db/session.py)
# and its own in-memory rate-limit state (slowapi) — size this to your
# host's CPU count, and re-check pool_size/max_overflow scale with it.
WEB_CONCURRENCY=4

# ── JWT ──────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_64_BYTE_HEX_SECRET
REFRESH_TOKEN_DAYS=30

# ── Cookies ──────────────────────────────────────────────────────
COOKIE_SECURE=true

# ── CORS — set to your internal hostname / IP ────────────────────
ALLOWED_ORIGINS=https://justice.internal

# ── Telegram ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=your_bot_name

# ── Email (optional) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Logging ──────────────────────────────────────────────────────
LOG_FORMAT=json
HSTS_MAX_AGE=31536000

# Backup encryption (age v1.2.1). Generate a key with:
#   sudo install -d -m 0700 /opt/justice/secrets
# Put the public recipient(s) here; keep private identities outside Git and out
# of production/API containers. During rotation list both old and new recipients.
AGE_BACKUP_RECIPIENTS=age1REPLACE_WITH_PUBLIC_RECIPIENT
AGE_BACKUP_RECIPIENTS_NEXT=
# Recovery-only private identity path; mounted read-only only by the recovery DB.
PGDATA=/opt/justice/pgdata
AGE_IDENTITY_PATH=/opt/justice/secrets/age-identity
PGDATA_RESTORE=/opt/justice/pgdata-restore
BACKUP_DIR=/opt/justice/backups
WAL_ARCHIVE_DIR=/opt/justice/wal-archive

# Keep BACKUP_ALERT_WEBHOOK out of this Compose env file. Configure it only in the
# host systemd service that runs deploy/backup.sh so app containers never receive it.

# Object storage: keep the endpoint unset until the selected provider passes the deployment gates.
# Use separate restricted identities for API writes and gateway reads.
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=justice-files
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_GATEWAY_ACCESS_KEY_ID=
STORAGE_GATEWAY_SECRET_ACCESS_KEY=
STORAGE_CA_BUNDLE_PATH=
FILE_STORAGE_TLS_DIR=/opt/justice/certs/storage
