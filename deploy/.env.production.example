# Copy to deploy/.env.production and fill in every value.
# NEVER commit .env.production to git.

# ── Database ─────────────────────────────────────────────────────
# Use a strong random password. Rotate annually.
DATABASE_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@db:5432/justice
DB_ADMIN_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@db:5432/justice
DB_USER=justice
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# ── Performance ──────────────────────────────────────────────────
# Number of uvicorn worker processes. Each worker is a separate OS
# process with its own DB connection pool (see backend/app/db/session.py)
# and its own in-memory rate-limit state (slowapi) — size this to your
# host's CPU count, and re-check pool_size/max_overflow scale with it.
WEB_CONCURRENCY=4

# ── JWT ──────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_64_BYTE_HEX_SECRET
REFRESH_TOKEN_DAYS=30

# ── Cookies ──────────────────────────────────────────────────────
COOKIE_SECURE=true

# ── CORS — set to your internal hostname / IP ────────────────────
ALLOWED_ORIGINS=https://justice.internal

# ── Telegram ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=your_bot_name

# ── Email (optional) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Exchange worker settings. Leave these unset for the standard
# production deployment. To enable Exchange, configure them and add
# deploy/docker-compose.exchange.prod.yml to the Compose file list.
# EXCHANGE_CALENDAR_ENABLED=true
# EXCHANGE_EWS_URL=https://exchange.example.local/EWS/Exchange.asmx
# EXCHANGE_MAILBOX=svc_justice@example.local
# EXCHANGE_USERNAME=DOMAIN\svc_justice
# EXCHANGE_AUTH_TYPE=NTLM
# Client-side cap: never exceed 200 requests/minute; lower this if the server admin requests it.
# EXCHANGE_REQUESTS_PER_MINUTE=200
# Path to a separately provisioned secret file; never put the password in this env file.
# EXCHANGE_PASSWORD_FILE=/opt/justice/secrets/exchange-password

# ── Logging ──────────────────────────────────────────────────────
LOG_FORMAT=json
HSTS_MAX_AGE=31536000
